{
  "service": {
    "name": "{{ item.name }}",

{% if item.port is defined %}
    "port": {{ item.port }},
{% endif %}

    "token": "{{ item.token | default(consul_agent_token) }}",

{% if item.tags is defined %}
    "tags": {{ item.tags | to_json }},
{% else %}
    "tags": {{ consul_service_tags | to_json }},
{% endif %}

{% if item.health_check is defined %}
    "check": {
      "id": "{{ item.name }}-check",
      "name": "{{ item.name }} Health Check",

{% if item.health_check.type == "http" %}
      "http": "{{ item.health_check.url }}",

{% elif item.health_check.type == "tcp" %}
      "tcp": "{{ item.health_check.url }}",

{% elif item.health_check.type == "grpc" %}
      "grpc": "{{ item.health_check.url }}",

{% endif %}

      "interval": "{{ item.health_check.interval | default(consul_service_check_interval) }}",
      "timeout": "{{ item.health_check.timeout | default(consul_service_check_timeout) }}"
    }
{% endif %}

  }
}
