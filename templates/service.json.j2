{
  "service": {
    "name": "{{ item.name }}",

{% if item.port is defined %}
    "port": {{ item.port }},
{% endif %}

    "token": "{{ item.token }}",

    "tags": [
{% if item.tags is defined %}
{% for tag in item.tags %}
      "{{ tag }}"{% if not loop.last %},{% endif %}
{% endfor %}
{% else %}
{% for tag in consul_service_tags %}
      "{{ tag }}"{% if not loop.last %},{% endif %}
{% endfor %}
{% endif %}
    ]

{% if item.url is defined or item.port is defined %}
    ,
    "check": {
      "id": "{{ item.name }}-check",
      "name": "{{ item.name }} Health Check",

{% if item.url is defined %}
      "http": "{{ item.url }}",
      "tls_skip_verify": true,
{% else %}
      "http": "http://{{ ansible_default_ipv4.address | default('localhost') }}:{{ item.port }}/",
{% endif %}

      "interval": "{{ consul_service_check_interval }}",
      "timeout": "{{ consul_service_check_timeout }}"
    }
{% endif %}

  }
}
