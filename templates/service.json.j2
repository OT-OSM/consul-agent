{
  "service": {
    "name": "{{ service_name }}",
    "port": {{ service_port }},
    "token": "{{ consul_agent_token }}",
    "check": {
      "id": "{{ service_name }}-check",
      "name": "{{ service_name }} Health Check",
      "tcp": "localhost:{{ service_port }}",
      "interval": "10s",
      "timeout": "2s"
    }
  }
}
