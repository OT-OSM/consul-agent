{% raw %}
static_resources:
  clusters:
  {{ range services }}
  - name: {{ .Name }}
    connect_timeout: 5s
    # STRICT_DNS is best here because we are providing the direct IP from Consul
    type: STRICT_DNS
    lb_policy: ROUND_ROBIN
    load_assignment:
      cluster_name: {{ .Name }}
      endpoints:
      - lb_endpoints:
        {{ range service .Name }}
        - endpoint:
            address:
              socket_address:
                address: {{ .Address }}
                port_value: {{ .Port }}
        {{ end }}

    # --- DYNAMIC TLS BLOCK ---
    # Only apply TLS if the service name matches your secure tools
    {{ if .Name | regexMatch "keycloak|minio|harbor|orchestrator|wazuh|consul" }}
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        common_tls_context:
          validation_context:
            trusted_ca:
              filename: "/etc/consul.d/tls.crt"
    {{ end }}

    # --- AUTOMATIC HEALTH CHECK ---
    health_checks:
      - timeout: 2s
        interval: 5s
        unhealthy_threshold: 3
        healthy_threshold: 2
        # Use TCP check for general reliability across different app types
        tcp_health_check: {}
  {{ end }}
{% endraw %}
