{% raw %}
static_resources:
  clusters:
  {{ range services }}
  - name: "{{ .Name }}"
    connect_timeout: 5s
    # Switch to STRICT_DNS so Envoy uses Consul DNS for resolution
    type: STRICT_DNS
    lb_policy: ROUND_ROBIN
    load_assignment:
      cluster_name: "{{ .Name }}"
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                # Use the service DNS name instead of the IP loop
                address: "{{ .Name }}.service.consul"
                # Pull the port dynamically from the first instance found
                port_value: {{ range service .Name }}{{ .Port }}{{ break }}{{ end }}

    # --- DYNAMIC TLS BLOCK ---
    {{ if .Name | regexMatch "keycloak|minio|harbor|orchestrator|wazuh|consul" }}
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        common_tls_context:
          validation_context:
            trusted_ca:
              filename: "/etc/consul.d/tls.crt"
    {{ end }}

    # --- AUTOMATIC HEALTH CHECK ---
    health_checks:
      - timeout: 2s
        interval: 5s
        unhealthy_threshold: 3
        healthy_threshold: 2
        tcp_health_check: {}
  {{ end }}
{% endraw %}
