{% raw %}
static_resources:
  clusters:
  {{ range services }}
  - name: "{{ .Name }}"
    connect_timeout: 5s
    # Using STATIC because Consul Template provides the direct IP addresses.
    # This is the most reliable way for your LDC setup.
    type: STATIC
    lb_policy: ROUND_ROBIN
    load_assignment:
      cluster_name: "{{ .Name }}"
      endpoints:
      - lb_endpoints:
        {{ range service .Name }}
        - endpoint:
            address:
              socket_address:
                # Automatically pulls the IP (192.168.8.x) from Consul
                address: "{{ .Address }}"
                # Automatically pulls the Port (8080/443/etc.) from Consul
                port_value: {{ .Port }}
        {{ end }}

    # --- DYNAMIC TLS BLOCK ---
    # This automatically adds Upstream TLS only for specified services
    {{ if .Name | regexMatch "keycloak|minio|harbor|orchestrator|wazuh|consul" }}
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        common_tls_context:
          validation_context:
            trusted_ca:
              filename: "/etc/consul.d/tls.crt"
    {{ end }}

    # --- AUTOMATIC HEALTH CHECK ---
    # Ensures Envoy stops sending traffic if the service instance is down
    health_checks:
      - timeout: 2s
        interval: 5s
        unhealthy_threshold: 3
        healthy_threshold: 2
        # TCP check is safest for mixed services (Keycloak, Minio, etc.)
        tcp_health_check: {}
  {{ end }}
{% endraw %}
